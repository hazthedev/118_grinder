---
import AnimatedSection from '../components/AnimatedSection';

const images = [
  { src: 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=800&q=80', alt: 'Pistachio green bar with plants' },
  { src: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&q=80', alt: 'Rattan chairs and natural light' },
  { src: 'https://images.unsplash.com/photo-1445116572660-236099ec97a0?w=800&q=80', alt: 'Latte art station' },
  { src: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?w=800&q=80', alt: 'Plant-filled corner with window seat' },
];
---

<section class="relative bg-[#f5ead4] py-14 sm:py-20 border-y border-[#1a0e08]/12">
  <div class="absolute inset-0 bg-blueprint-fine opacity-40 pointer-events-none"></div>
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <AnimatedSection client:visible className="text-center mb-8">
      <span class="stamp justify-center" style="display:inline-flex;">Carousel · Field Notes</span>
      <p class="font-display text-2xl sm:text-3xl text-espresso max-w-md mx-auto mt-3 italic font-accent normal-case tracking-tight">
        "Plants, pistachio, and a window seat that's almost always free."
      </p>
    </AnimatedSection>
    <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 no-scrollbar">
      {images.map((img, i) => (
        <div class="snap-center shrink-0 w-[75vw] sm:w-[45vw] lg:w-[30vw] aspect-[4/3] overflow-hidden bg-[#1a0e08] border border-[#1a0e08]/15 relative">
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-full object-cover hover-zoom-standalone"
            loading="lazy"
            onerror="this.style.display='none'"
          />
          <span class="absolute top-3 left-3 font-mono text-[10px] uppercase tracking-[0.3em] text-[#f5ead4]/90 bg-[#1a0e08]/70 px-2 py-0.5">Plate № 0{i+1}</span>
        </div>
      ))}
    </div>
  </div>
</section>
