---
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AnimatedSection from '../components/AnimatedSection';
---

<section class="bg-off-white pt-24 sm:pt-32 pb-12 sm:pb-16">
  <Container>
    <AnimatedSection client:visible>
      <SectionHeading
        title="The Menu"
        subtitle="Specialty coffee, slow desserts, and a few favorites for when you're hungry."
        align="center"
        class="max-w-2xl mx-auto"
      />
    </AnimatedSection>
  </Container>
</section>
