---
import AnimatedSection from '../components/AnimatedSection';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';

const spots = [
  { src: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?w=600&q=80', alt: 'Pistachio bar corner with natural light' },
  { src: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?w=600&q=80', alt: 'Rattan chair setup against green wall' },
  { src: 'https://images.unsplash.com/photo-1521017432531-fbd92d768814?w=600&q=80', alt: 'Window seat with plants and coffee' },
  { src: 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=600&q=80', alt: 'Aesthetic table setting with dessert' },
];
---

<section class="relative bg-[#f5ead4] py-20 sm:py-28">
  <div class="absolute inset-0 bg-blueprint opacity-30 pointer-events-none"></div>
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <AnimatedSection client:visible className="mb-12 sm:mb-16">
      <span class="stamp">Field Studies · Frame-Worthy</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-espresso uppercase tracking-tight leading-[0.95] mt-4 max-w-3xl">
        Bring your camera. Most of our regulars do.
      </h2>
    </AnimatedSection>
    <StaggerContainer client:visible className="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" staggerDelay={0.1}>
      {spots.map((spot, i) => (
        <StaggerItem>
          <div class="relative aspect-square overflow-hidden bg-[#1a0e08] border border-[#1a0e08]/15 group">
            <img
              src={spot.src}
              alt={spot.alt}
              class="w-full h-full object-cover hover-zoom-standalone"
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <span class="absolute top-2 left-2 font-mono text-[9px] uppercase tracking-[0.3em] text-[#f5ead4]/90 bg-[#1a0e08]/60 px-1.5 py-0.5">№ 0{i+1}</span>
            <span class="absolute bottom-2 right-2 w-4 h-4 border-r border-b border-[#c97b3a]/80"></span>
          </div>
        </StaggerItem>
      ))}
    </StaggerContainer>
  </div>
</section>
