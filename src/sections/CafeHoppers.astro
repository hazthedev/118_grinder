---
const spots = [
  { src: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?w=600&q=80', alt: 'Pistachio bar corner with natural light' },
  { src: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?w=600&q=80', alt: 'Rattan chair setup against green wall' },
  { src: 'https://images.unsplash.com/photo-1521017432531-fbd92d768814?w=600&q=80', alt: 'Window seat with plants and coffee' },
  { src: 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=600&q=80', alt: 'Aesthetic table setting with dessert' },
];
---

<section class="bg-off-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-forest-green">Instagrammable</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-deep-forest mt-3">
        Bring your camera. Most of our regulars do.
      </h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      {spots.map((spot) => (
        <div class="aspect-square rounded-2xl overflow-hidden bg-wheat-beige">
          <img
            src={spot.src}
            alt={spot.alt}
            class="w-full h-full object-cover hover:scale-[1.03] transition-transform duration-500"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>
