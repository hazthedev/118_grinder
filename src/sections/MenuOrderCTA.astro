---
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import site from '../data/site.json';
---

<section class="relative bg-[#f5ead4] py-20 sm:py-28">
  <div class="absolute inset-0 bg-blueprint opacity-30 pointer-events-none"></div>
  <Container class="relative">
    <div class="text-center max-w-2xl mx-auto space-y-6">
      <span class="stamp justify-center" style="display:inline-flex;">Direct Line</span>
      <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl text-espresso uppercase tracking-tight leading-[0.95]">See you soon?</h2>
      <p class="text-base sm:text-lg text-[#3a2a20] leading-relaxed font-body italic">
        WhatsApp us — for table holds, custom cake orders, or just to ask if your favorite's in stock today.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <Button href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" variant="filled">
          WhatsApp Us
        </Button>
        <Button href={site.social.instagram} target="_blank" rel="noopener noreferrer" variant="outline">
          DM on Instagram
        </Button>
      </div>
    </div>
  </Container>
</section>
