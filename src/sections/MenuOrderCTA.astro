---
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import site from '../data/site.json';
---

<section class="bg-cream py-20 sm:py-28">
  <Container>
    <div class="text-center max-w-xl mx-auto space-y-6">
      <h2 class="font-display text-2xl sm:text-3xl text-deep-forest">See you soon?</h2>
      <p class="text-base text-sage-grey leading-relaxed">
        WhatsApp us — for table holds, custom cake orders, or just to ask if your favorite's in stock today.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <Button href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" variant="filled">
          WhatsApp Us
        </Button>
        <Button href={site.social.instagram} target="_blank" rel="noopener noreferrer" variant="outline">
          DM on Instagram
        </Button>
      </div>
    </div>
  </Container>
</section>
