---
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MenuCard from '../components/MenuCard.astro';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';

const sweets = [
  {
    name: 'Tiramisu',
    description: 'Viral for a reason. Layers of coffee-soaked sponge and mascarpone.',
    price: 'RM 18',
    image: 'https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?w=600&q=80',
    signature: true,
  },
  {
    name: 'Vanilla Cheesecake',
    description: 'Silky, light, and just sweet enough. A quiet classic.',
    price: 'RM 16',
    image: 'https://images.unsplash.com/photo-1533134242443-d4fd215305ad?w=600&q=80',
    signature: true,
  },
  {
    name: 'Chocolate Cremeux',
    description: 'Dense, dark, and deeply chocolatey. For serious dessert people.',
    price: 'RM 17',
    image: 'https://images.unsplash.com/photo-1606313564200-e75d5e30476c?w=600&q=80',
    signature: true,
  },
  {
    name: 'Carrot Cake',
    description: 'Spiced, moist, and topped with cream cheese frosting.',
    price: 'RM 15',
    image: 'https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=600&q=80',
    signature: false,
  },
];
---

<section class="relative bg-[#1a0e08] text-[#f5ead4]">
  <div class="absolute inset-0 bg-blueprint-fine opacity-40 pointer-events-none"></div>
  <Container class="relative py-20 sm:py-28">
    <div class="absolute top-10 right-6 hidden md:flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.3em] text-[#c97b3a]/70">
      <span>Series — B</span>
      <span class="block w-12 h-px bg-[#c97b3a]"></span>
      <span>Pastry Roster</span>
    </div>
    <StaggerContainer client:visible className="mb-12 sm:mb-16" staggerDelay={0.08}>
      <StaggerItem>
        <div class="flex flex-col gap-4 items-start text-left">
          <span class="stamp" style="color:#c97b3a;">Sweet Things</span>
          <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-[#f5ead4] leading-[0.95] tracking-tight uppercase">
            Small menu, made fresh.
          </h2>
          <p class="max-w-xl text-base sm:text-lg text-[#e8c89a] leading-relaxed italic">
            Best enjoyed slowly, with a second drink you didn't plan on ordering.
          </p>
        </div>
      </StaggerItem>
    </StaggerContainer>

    <StaggerContainer client:visible className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8" staggerDelay={0.1}>
      {sweets.map((sweet, i) => (
        <StaggerItem>
          <MenuCard {...sweet} index={i} />
        </StaggerItem>
      ))}
    </StaggerContainer>
  </Container>
</section>
