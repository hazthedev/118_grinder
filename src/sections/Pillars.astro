---
import Container from '../components/Container.astro';
import AnimatedSection from '../components/AnimatedSection';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';

const pillars = [
  {
    code: 'I',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="14" y="22" width="36" height="32" rx="2"/>
      <path d="M50 28h4a4 4 0 0 1 0 8h-4"/>
      <line x1="20" y1="14" x2="20" y2="22"/>
      <line x1="32" y1="14" x2="32" y2="22"/>
      <line x1="44" y1="14" x2="44" y2="22"/>
      <line x1="14" y1="46" x2="50" y2="46" stroke-dasharray="2 2"/>
    </svg>`,
    title: 'Coffee.',
    grade: 'A · 01',
    description: 'Beans pulled with care, milk steamed properly, latte art that actually means something.',
  },
  {
    code: 'II',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 28h36v18a4 4 0 0 1-4 4H18a4 4 0 0 1-4-4z"/>
      <path d="M16 36s2-3 6-3 5 4 8 4 5-4 8-4 5 4 8 4 4-1 4-1"/>
      <line x1="20" y1="20" x2="20" y2="28"/>
      <line x1="32" y1="14" x2="32" y2="28"/>
      <line x1="44" y1="20" x2="44" y2="28"/>
      <path d="M30 12c0 2 4 2 4 0" />
    </svg>`,
    title: 'Dessert.',
    grade: 'A · 02',
    description: 'Tiramisu, cheesecake, carrot cake — small menu, made fresh, gone fast.',
  },
  {
    code: 'III',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="32" cy="32" r="22"/>
      <path d="M32 14a10 18 0 0 0 0 36 10 18 0 0 0 0 -36" />
      <path d="M14 32h36" stroke-dasharray="2 3"/>
      <circle cx="32" cy="32" r="2" fill="currentColor"/>
    </svg>`,
    title: 'Calm.',
    grade: 'A · 03',
    description: 'Plants, soft music, low chairs. Less crowded, more space to breathe.',
  },
];
---

<section class="relative bg-[#f5ead4] border-y border-[#1a0e08]/12">
  <div class="absolute inset-0 bg-blueprint-fine opacity-40 pointer-events-none"></div>
  <Container class="relative py-14 sm:py-20">
    <div class="flex items-center gap-4 mb-10">
      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#c97b3a]">Spec Sheet — Three Pillars</span>
      <span class="flex-1 h-px bg-[#1a0e08]/20"></span>
    </div>

    <StaggerContainer client:visible className="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8" staggerDelay={0.12}>
      {pillars.map((pillar) => (
        <StaggerItem>
          <div class="card-spec p-7 flex flex-col items-start text-left gap-4 h-full">
            <div class="flex items-center justify-between w-full">
              <div class="text-[#c97b3a]" set:html={pillar.icon} />
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#5c5048]">{pillar.grade}</span>
            </div>
            <div class="flex items-baseline gap-3">
              <span class="display-num text-[#c97b3a] text-4xl">{pillar.code}</span>
              <h3 class="font-display text-3xl tracking-wide uppercase text-espresso">{pillar.title}</h3>
            </div>
            <p class="text-sm text-[#5c5048] leading-relaxed font-body italic max-w-sm">{pillar.description}</p>
            <hr class="rule-hash w-full mt-2" />
          </div>
        </StaggerItem>
      ))}
    </StaggerContainer>
  </Container>
</section>
