---
import Container from '../components/Container.astro';
import AnimatedSection from '../components/AnimatedSection';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';

const pillars = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
    title: 'Coffee.',
    description: 'Beans pulled with care, milk steamed properly, latte art that actually means something.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/></svg>`,
    title: 'Dessert.',
    description: 'Tiramisu, cheesecake, carrot cake — small menu, made fresh, gone fast.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.6C9.4 5.5 9 4.3 9 3c0-1.5 1-2 2-2s2 .5 2 2c0 1.3-.4 2.5-.8 3.6A7 7 0 0 1 11 20z"/><path d="M11 20v3"/><path d="M8 23h6"/></svg>`,
    title: 'Calm.',
    description: 'Plants, soft music, low chairs. Less crowded, more space to breathe.',
  },
];
---

<section class="bg-cream border-y border-wheat-beige/50">
  <Container class="py-14 sm:py-20">
    <StaggerContainer client:visible className="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6" staggerDelay={0.12}>
      {pillars.map((pillar) => (
        <StaggerItem>
          <div class="flex flex-col items-center md:items-start text-center md:text-left gap-4 p-6 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:bg-wheat-beige/30">
            <div class="text-pistachio" set:html={pillar.icon} />
            <h3 class="font-display text-xl text-deep-forest">{pillar.title}</h3>
            <p class="text-sm text-sage-grey leading-relaxed max-w-xs">{pillar.description}</p>
          </div>
        </StaggerItem>
      ))}
    </StaggerContainer>
  </Container>
</section>
