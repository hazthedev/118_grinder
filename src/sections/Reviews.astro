---
import Container from '../components/Container.astro';
import AnimatedSection from '../components/AnimatedSection';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';
import reviews from '../data/reviews.json';
import site from '../data/site.json';

const stars = (rating: number) => {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5;
  const empty = 5 - full - (half ? 1 : 0);
  return { full, half, empty };
};
---

<section class="relative bg-[#1a0e08] text-[#f5ead4] py-20 sm:py-28 overflow-hidden">
  <div class="absolute inset-0 bg-blueprint opacity-15 pointer-events-none"></div>
  <Container class="relative">
    <AnimatedSection client:visible className="mb-14 sm:mb-20">
      <div class="grid grid-cols-12 gap-8 items-end">
        <div class="col-span-12 md:col-span-5">
          <span class="stamp" style="color:#c97b3a;">Tasting Notes · Reviews</span>
          <div class="display-num text-[#c97b3a] mt-3">{site.ratings.google.score}<span class="text-[#5c5048]">/5</span></div>
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#e8c89a] mt-1">
            {site.ratings.google.count}+ regulars on Google
          </p>
        </div>
        <div class="col-span-12 md:col-span-7">
          <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-[#f5ead4] uppercase tracking-tight leading-[0.95]">
            Pulled from the<br/>
            <span class="italic font-accent normal-case text-[#c97b3a] lowercase">guestbook</span>.
          </h2>
        </div>
      </div>
    </AnimatedSection>

    <StaggerContainer client:visible className="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8" staggerDelay={0.12}>
      {reviews.map((review, i) => {
        const s = stars(review.rating);
        const num = String(i + 1).padStart(2, '0');
        return (
          <StaggerItem>
            <article class="relative bg-[#2a1610] border border-[#c97b3a]/30 p-7 sm:p-8 flex flex-col gap-4 h-full hover:border-[#c97b3a] transition-colors duration-500">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#c97b3a]">№ {num}</span>
                <div class="flex items-center gap-0.5 text-[#c97b3a]">
                  {Array.from({ length: s.full }).map(() => (
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  ))}
                  {s.half && (
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" opacity="0.4"/></svg>
                  )}
                  {Array.from({ length: s.empty }).map(() => (
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" opacity="0.25"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  ))}
                </div>
              </div>
              <p class="text-base text-[#f5ead4] leading-relaxed flex-1 font-body italic">
                "{review.quote}"
              </p>
              <div class="pt-4 border-t border-[#c97b3a]/20">
                <p class="font-display text-base tracking-[0.1em] uppercase text-[#f5ead4]">{review.name}</p>
                <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-[#c97b3a]/80 mt-0.5">{review.date}</p>
              </div>
            </article>
          </StaggerItem>
        );
      })}
    </StaggerContainer>
  </Container>
</section>
