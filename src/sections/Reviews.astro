---
import Container from '../components/Container.astro';
import reviews from '../data/reviews.json';
import site from '../data/site.json';

const stars = (rating: number) => {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5;
  const empty = 5 - full - (half ? 1 : 0);
  return { full, half, empty };
};
---

<section class="bg-cream py-20 sm:py-28">
  <Container>
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-pistachio">Reviews</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-deep-forest mt-3">
        {site.ratings.google.score} / 5 from {site.ratings.google.count}+ regulars on Google
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {reviews.map((review) => {
        const s = stars(review.rating);
        return (
          <article class="bg-off-white rounded-2xl p-6 sm:p-8 flex flex-col gap-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
            <div class="flex items-center gap-1 text-pistachio">
              {Array.from({ length: s.full }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
              {s.half && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" opacity="0.3"/></svg>
              )}
              {Array.from({ length: s.empty }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" opacity="0.3"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="text-sm sm:text-base text-deep-forest leading-relaxed flex-1">
              "{review.quote}"
            </p>
            <div class="pt-4 border-t border-wheat-beige/50">
              <p class="text-sm font-medium text-deep-forest">{review.name}</p>
              <p class="text-xs text-sage-grey">{review.date}</p>
            </div>
          </article>
        );
      })}
    </div>
  </Container>
</section>
