---
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MenuCard from '../components/MenuCard.astro';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';

const drinks = [
  {
    name: 'Spanish Latte',
    description: 'Smooth, sweet, slightly nutty. Our most-ordered. Get it iced.',
    price: 'RM 14',
    image: 'https://images.unsplash.com/photo-1572442388796-11668a67e53d?w=600&q=80',
    signature: true,
  },
  {
    name: 'Matcha Strawberry',
    description: 'Earthy matcha layered with sweet strawberry. Pretty and balanced.',
    price: 'RM 16',
    image: 'https://images.unsplash.com/photo-1515823064-d6e0c04616a7?w=600&q=80',
    signature: true,
  },
  {
    name: 'Pandan Colada',
    description: 'Tropical, creamy, and unmistakably local. A crowd favorite.',
    price: 'RM 15',
    image: 'https://images.unsplash.com/photo-1546173159-315724a31696?w=600&q=80',
    signature: true,
  },
  {
    name: "Hershey's Mocha",
    description: 'Rich chocolate meets bold espresso. Comfort in a cup.',
    price: 'RM 15',
    image: 'https://images.unsplash.com/photo-1579992357154-faf4bde95b3d?w=600&q=80',
    signature: false,
  },
];
---

<section class="bg-off-white">
  <Container class="py-20 sm:py-28">
    <StaggerContainer client:visible className="mb-12 sm:mb-16" staggerDelay={0.08}>
      <StaggerItem>
        <SectionHeading
          eyebrow="Most-Ordered"
          title="The ones everyone orders."
          subtitle="We stopped trying to predict it — these just always win."
        />
      </StaggerItem>
    </StaggerContainer>

    <StaggerContainer client:visible className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8" staggerDelay={0.1}>
      {drinks.map((drink) => (
        <StaggerItem>
          <MenuCard {...drink} />
        </StaggerItem>
      ))}
    </StaggerContainer>
  </Container>
</section>
