---
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import AnimatedSection from '../components/AnimatedSection';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';
import site from '../data/site.json';
---

<section class="relative bg-[#1a0e08] text-[#f5ead4] py-20 sm:py-28">
  <div class="absolute inset-0 bg-blueprint opacity-15 pointer-events-none"></div>
  <Container class="relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <!-- Map -->
      <AnimatedSection client:visible>
        <div class="relative aspect-[4/3] lg:aspect-auto lg:h-full min-h-[320px] overflow-hidden bg-[#2a1610] border border-[#c97b3a]/30">
          <span class="absolute top-0 left-0 w-6 h-6 border-l border-t border-[#c97b3a] z-10"></span>
          <span class="absolute top-0 right-0 w-6 h-6 border-r border-t border-[#c97b3a] z-10"></span>
          <span class="absolute bottom-0 left-0 w-6 h-6 border-l border-b border-[#c97b3a] z-10"></span>
          <span class="absolute bottom-0 right-0 w-6 h-6 border-r border-b border-[#c97b3a] z-10"></span>
          <iframe
            src={site.googleMapsEmbed}
            width="100%"
            height="100%"
            style="border:0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="118 Grinder location on Google Maps"
            class="absolute inset-0 w-full h-full grayscale contrast-105"
          />
        </div>
      </AnimatedSection>

      <!-- Details -->
      <StaggerContainer client:visible className="flex flex-col gap-8" staggerDelay={0.1}>
        <StaggerItem>
          <div>
            <span class="stamp" style="color:#c97b3a;">Address · Coordinates</span>
            <p class="mt-3 text-lg sm:text-xl text-[#f5ead4] leading-relaxed font-body">
              {site.address.street}<br />
              {site.address.area}, {site.address.postcode} {site.address.city}, {site.address.country}
            </p>
          </div>
        </StaggerItem>

        <StaggerItem>
          <div>
            <span class="stamp" style="color:#c97b3a;">Contact · Direct Line</span>
            <div class="mt-3 flex flex-col gap-2">
              <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-lg text-[#f5ead4] link-copper font-mono tracking-wider w-fit">
                {site.phone}
              </a>
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-lg text-[#f5ead4] link-copper font-mono tracking-wider w-fit">
                WhatsApp
              </a>
            </div>
          </div>
        </StaggerItem>

        <StaggerItem>
          <div>
            <span class="stamp" style="color:#c97b3a;">Parking · Notes</span>
            <p class="mt-3 text-base text-[#e8c89a] leading-relaxed font-body italic">
              Street parking available along Jalan Wangsa Delima 5. Malls and shop lots nearby for additional parking on busy weekends.
            </p>
          </div>
        </StaggerItem>

        <StaggerItem>
          <div class="pt-2">
            <Button href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" variant="filled">
              Message Us on WhatsApp
            </Button>
          </div>
        </StaggerItem>
      </StaggerContainer>
    </div>
  </Container>
</section>
