---
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import AnimatedSection from '../components/AnimatedSection';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';
import site from '../data/site.json';
---

<section class="bg-cream py-20 sm:py-28">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <!-- Map -->
      <AnimatedSection client:visible>
        <div class="relative aspect-[4/3] lg:aspect-auto lg:h-full min-h-[320px] rounded-3xl overflow-hidden bg-wheat-beige">
          <iframe
            src={site.googleMapsEmbed}
            width="100%"
            height="100%"
            style="border:0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="118 Grinder location on Google Maps"
            class="absolute inset-0 w-full h-full"
          />
        </div>
      </AnimatedSection>

      <!-- Details -->
      <StaggerContainer client:visible className="flex flex-col gap-8" staggerDelay={0.1}>
        <StaggerItem>
          <div>
            <span class="text-xs font-medium uppercase tracking-[0.2em] text-forest-green">Address</span>
            <p class="mt-2 text-base sm:text-lg text-deep-forest leading-relaxed">
              {site.address.street}<br />
              {site.address.area}, {site.address.postcode} {site.address.city}, {site.address.country}
            </p>
          </div>
        </StaggerItem>

        <StaggerItem>
          <div>
            <span class="text-xs font-medium uppercase tracking-[0.2em] text-forest-green">Contact</span>
            <div class="mt-2 flex flex-col gap-2">
              <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-base text-deep-forest hover:text-forest-green transition-colors duration-300 ease-breathe">
                {site.phone}
              </a>
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-base text-deep-forest hover:text-forest-green transition-colors duration-300 ease-breathe">
                WhatsApp
              </a>
            </div>
          </div>
        </StaggerItem>

        <StaggerItem>
          <div>
            <span class="text-xs font-medium uppercase tracking-[0.2em] text-forest-green">Parking</span>
            <p class="mt-2 text-base text-sage-grey leading-relaxed">
              Street parking available along Jalan Wangsa Delima 5. Malls and shop lots nearby for additional parking on busy weekends.
            </p>
          </div>
        </StaggerItem>

        <StaggerItem>
          <div class="pt-2">
            <Button href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" variant="filled">
              Message Us on WhatsApp
            </Button>
          </div>
        </StaggerItem>
      </StaggerContainer>
    </div>
  </Container>
</section>
