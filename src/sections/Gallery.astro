---
import Container from '../components/Container.astro';
import AnimatedSection from '../components/AnimatedSection';
import GalleryLightbox from '../components/GalleryLightbox';

const images = [
  {
    src: 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=1200&q=80',
    alt: 'Pistachio green cafe interior with plants and rattan chairs',
    caption: 'The pistachio bar',
  },
  {
    src: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&q=80',
    alt: 'Three hands holding latte art cups',
    caption: 'Coffee with friends',
  },
  {
    src: 'https://images.unsplash.com/photo-1445116572660-236099ec97a0?w=800&q=80',
    alt: 'Minimalist cafe corner with natural light',
    caption: 'Morning light',
  },
  {
    src: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?w=800&q=80',
    alt: 'Green plants and coffee setup on marble',
    caption: 'Plant corner',
  },
  {
    src: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?w=800&q=80',
    alt: 'Aesthetic dessert plating with flowers',
    caption: 'Tiramisu moment',
  },
  {
    src: 'https://images.unsplash.com/photo-1521017432531-fbd92d768814?w=800&q=80',
    alt: 'Window seat with coffee and notebook',
    caption: 'Slow afternoons',
  },
  {
    src: 'https://images.unsplash.com/photo-1498804103079-a6351b050096?w=1200&q=80',
    alt: 'Coffee being poured into cup from above',
    caption: 'The pour',
  },
];
---

<section class="relative bg-[#f5ead4] py-20 sm:py-28">
  <div class="absolute inset-0 bg-blueprint opacity-30 pointer-events-none"></div>
  <Container class="relative">
    <AnimatedSection client:visible className="mb-12 sm:mb-16">
      <div class="flex flex-col gap-3 items-start">
        <span class="stamp">Plate Series · Aesthetic</span>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl text-espresso uppercase tracking-tight leading-[0.95]">
          The feed, in real life.
        </h2>
        <div class="flex items-center gap-3 mt-2 font-mono text-[10px] uppercase tracking-[0.3em] text-[#5c5048]">
          <span class="text-[#c97b3a]">▲</span>
          <span>seven plates · field shots</span>
        </div>
      </div>
    </AnimatedSection>

    <GalleryLightbox client:visible images={images} />
  </Container>
</section>
