---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page Not Found | 118 Grinder"
  description="Sorry, we couldn't find that page. Visit 118 Grinder in Wangsa Maju for specialty coffee and desserts."
>
  <section class="relative min-h-[70vh] flex items-center justify-center px-5 bg-[#f5ead4] overflow-hidden">
    <div class="absolute inset-0 bg-blueprint opacity-40 pointer-events-none"></div>
    <div class="relative text-center max-w-md space-y-6">
      <span class="stamp justify-center" style="display:inline-flex;">Error · Off-Grid</span>
      <span class="display-num block text-[#c97b3a]" style="font-size:clamp(7rem,16vw,12rem);">404</span>
      <h1 class="font-display text-4xl sm:text-5xl uppercase tracking-tight text-espresso">Page not found</h1>
      <p class="text-base text-[#3a2a20] leading-relaxed font-body italic">
        Looks like this page took a day off — just like we do on Mondays.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <Button href="/" variant="filled">Back to Home</Button>
        <Button href="/menu" variant="outline">See the Menu</Button>
      </div>
    </div>
  </section>
</BaseLayout>
