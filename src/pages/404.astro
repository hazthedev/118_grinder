---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page Not Found | 118 Grinder"
  description="Sorry, we couldn't find that page. Visit 118 Grinder in Wangsa Maju for specialty coffee and desserts."
>
  <section class="min-h-[70vh] flex items-center justify-center px-5">
    <div class="text-center max-w-md space-y-6">
      <span class="font-display text-8xl text-pistachio/40">404</span>
      <h1 class="font-display text-3xl sm:text-4xl text-deep-forest">Page not found</h1>
      <p class="text-base text-sage-grey leading-relaxed">
        Looks like this page took a day off — just like we do on Mondays.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <Button href="/" variant="filled">Back to Home</Button>
        <Button href="/menu" variant="outline">See the Menu</Button>
      </div>
    </div>
  </section>
</BaseLayout>
