---
export interface Props {
  name: string;
  description: string;
  price: string;
  image: string;
  signature?: boolean;
  href?: string;
}

const { name, description, price, image, signature = false, href } = Astro.props;
---

<article class="group relative flex flex-col bg-cream rounded-2xl overflow-hidden transition-all duration-500 ease-breathe hover:-translate-y-1.5 hover:shadow-[0_12px_40px_-8px_rgba(157,190,141,0.25)]">
  <a href={href || '#'} class="block">
    <div class="relative aspect-[4/5] overflow-hidden bg-wheat-beige">
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover transition-transform duration-700 ease-breathe group-hover:scale-[1.04]"
        loading="lazy"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="absolute inset-0 hidden items-center justify-center bg-wheat-beige">
        <svg class="w-12 h-12 text-pistachio/40" viewBox="0 0 64 64" fill="none">
          <path d="M16 48c0-16 8-24 16-24s16 8 16 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M24 28c0-8 4-12 8-12s8 4 8 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <ellipse cx="32" cy="20" rx="6" ry="3" stroke="currentColor" stroke-width="2"/>
          <path d="M42 20h4c4 0 6 3 6 7s-2 7-6 7h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M20 48h24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      {signature && (
        <span class="absolute top-3 left-3 bg-pistachio text-deep-forest text-[10px] font-semibold uppercase tracking-wider px-3 py-1 rounded-full">
          Signature
        </span>
      )}
    </div>
    <div class="p-5 flex flex-col gap-1">
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="font-display text-lg text-deep-forest">{name}</h3>
        <span class="text-sm font-medium text-forest-green whitespace-nowrap">{price}</span>
      </div>
      <p class="text-sm italic text-sage-grey leading-relaxed">{description}</p>
    </div>
  </a>
</article>