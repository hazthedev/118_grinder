---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'left', class: className = '' } = Astro.props;

const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col gap-3 ${alignClass} ${className}`}>
  {eyebrow && (
    <span class="text-xs font-medium uppercase tracking-[0.2em] text-pistachio">
      {eyebrow}
    </span>
  )}
  <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-deep-forest leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="max-w-xl text-base sm:text-lg text-sage-grey leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
