---
export interface Props {
  src: string;
  alt: string;
  class?: string;
  aspect?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, class: className = '', aspect = 'aspect-[4/5]', loading = 'lazy' } = Astro.props;
---

<div class={`relative overflow-hidden bg-wheat-beige ${aspect} ${className}`}>
  <img
    src={src}
    alt={alt}
    class="w-full h-full object-cover transition-transform duration-700 ease-out"
    loading={loading}
    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
  />
  <div class="absolute inset-0 hidden items-center justify-center bg-wheat-beige">
    <svg class="w-12 h-12 text-pistachio/40" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 48c0-16 8-24 16-24s16 8 16 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M24 28c0-8 4-12 8-12s8 4 8 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <ellipse cx="32" cy="20" rx="6" ry="3" stroke="currentColor" stroke-width="2"/>
      <path d="M42 20h4c4 0 6 3 6 7s-2 7-6 7h-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M20 48h24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </div>
</div>
