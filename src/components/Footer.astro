---
import Container from './Container.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-forest text-cream/90">
  <Container class="py-16 sm:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-8">
      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <span class="font-display text-2xl text-cream">118 Grinder</span>
        <p class="text-sm text-cream/70 leading-relaxed max-w-xs">
          A quiet corner in Wangsa Maju. Specialty coffee, viral desserts, and a pistachio-green space that feels like home.
        </p>
        <div class="flex items-center gap-4 mt-2">
          <a
            href="https://instagram.com/118grinder"
            target="_blank"
            rel="noopener noreferrer"
            class="text-cream/60 hover:text-pistachio hover-color"
            aria-label="Instagram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a
            href="https://tiktok.com/@118grindercafe"
            target="_blank"
            rel="noopener noreferrer"
            class="text-cream/60 hover:text-pistachio hover-color"
            aria-label="TikTok"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.88-2.89 2.89 2.89 0 0 1 2.88-2.89c.3 0 .58.06.85.14V9.4a6.37 6.37 0 0 0-.85-.06A6.34 6.34 0 0 0 3.1 15.68a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.47a8.18 8.18 0 0 0 4.8 1.55V6.82a4.85 4.85 0 0 1-1-.13z"/></svg>
          </a>
        </div>
      </div>

      <!-- Hours -->
      <div class="flex flex-col gap-4">
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-forest-green">Hours</span>
        <ul class="text-sm text-cream/70 space-y-2">
          <li class="flex justify-between gap-4">
            <span>Mon</span>
            <span class="text-pistachio font-medium">Closed</span>
          </li>
          <li class="flex justify-between gap-4">
            <span>Tue – Sun</span>
            <span>11:00 – 22:00</span>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="flex flex-col gap-4">
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-forest-green">Find Us</span>
        <address class="not-italic text-sm text-cream/70 leading-relaxed">
          65, Jalan Wangsa Delima 5,<br />
          Wangsa Maju, 53300 Kuala Lumpur
        </address>
        <a
          href="tel:+60132333997"
          class="text-sm text-cream/70 hover:text-pistachio hover-color"
        >
          013-233 3997
        </a>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-cream/10 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-cream/40">
        &copy; {currentYear} 118 Grinder. A quiet corner in Wangsa Maju.
      </p>
      <p class="text-xs text-cream/40">
        Made with care in KL.
      </p>
    </div>
  </Container>
</footer>
