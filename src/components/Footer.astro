---
import Container from './Container.astro';

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-[#1a0e08] text-[#f5ead4] overflow-hidden">
  <!-- Faint blueprint -->
  <div class="absolute inset-0 bg-blueprint opacity-15 pointer-events-none"></div>
  <!-- Top copper rule -->
  <div class="relative h-1 bg-gradient-to-r from-[#c97b3a] via-[#c97b3a]/70 to-transparent"></div>

  <Container class="relative py-16 sm:py-20">
    <!-- Big banner mark -->
    <div class="flex items-center gap-4 mb-12 sm:mb-14">
      <span class="font-mono text-[10px] uppercase tracking-[0.35em] text-[#c97b3a]">Form / 118 — KL · MY</span>
      <span class="flex-1 h-px bg-[#c97b3a]/30"></span>
      <span class="font-mono text-[10px] uppercase tracking-[0.35em] text-[#c97b3a]">Brewed Slow</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-8">
      <!-- Brand -->
      <div class="flex flex-col gap-4">
        <span class="font-display text-4xl tracking-[0.05em] uppercase text-[#f5ead4]">118 Grinder</span>
        <p class="text-sm text-[#e8c89a] leading-relaxed max-w-xs italic font-body">
          A quiet corner in Wangsa Maju. Specialty coffee, viral desserts, and a pistachio-green space that feels like home.
        </p>
        <div class="flex items-center gap-4 mt-2">
          <a
            href="https://instagram.com/118grinder"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#e8c89a] hover:text-[#c97b3a] hover-color"
            aria-label="Instagram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a
            href="https://tiktok.com/@118grindercafe"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#e8c89a] hover:text-[#c97b3a] hover-color"
            aria-label="TikTok"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.88-2.89 2.89 2.89 0 0 1 2.88-2.89c.3 0 .58.06.85.14V9.4a6.37 6.37 0 0 0-.85-.06A6.34 6.34 0 0 0 3.1 15.68a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.47a8.18 8.18 0 0 0 4.8 1.55V6.82a4.85 4.85 0 0 1-1-.13z"/></svg>
          </a>
        </div>
      </div>

      <!-- Hours -->
      <div class="flex flex-col gap-4">
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#c97b3a]">Hours · 24h Cycle</span>
        <ul class="text-sm space-y-2.5">
          <li class="flex justify-between items-center gap-4 border-b border-[#c97b3a]/15 pb-2">
            <span class="font-display text-base tracking-wide uppercase">Mon</span>
            <span class="font-mono text-xs text-[#c97b3a] uppercase tracking-[0.2em]">Closed</span>
          </li>
          <li class="flex justify-between items-center gap-4">
            <span class="font-display text-base tracking-wide uppercase">Tue – Sun</span>
            <span class="font-mono text-xs text-[#e8c89a] uppercase tracking-[0.2em]">11:00 – 22:00</span>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="flex flex-col gap-4">
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#c97b3a]">Find Us · Coordinates</span>
        <address class="not-italic text-sm text-[#e8c89a] leading-relaxed font-body">
          65, Jalan Wangsa Delima 5,<br />
          Wangsa Maju, 53300 Kuala Lumpur
        </address>
        <a
          href="tel:+60132333997"
          class="text-sm text-[#f5ead4] link-copper font-mono tracking-wider"
        >
          013-233 3997
        </a>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-[#c97b3a]/25 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#e8c89a]/60">
        &copy; {currentYear} 118 Grinder · A quiet corner in Wangsa Maju
      </p>
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-[#e8c89a]/60">
        Pulled with care · KL
      </p>
    </div>
  </Container>
</footer>
