---
export interface Props {
  variant?: 'filled' | 'outline' | 'ghost';
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const { variant = 'filled', href, class: className = '', target, rel } = Astro.props;

const variants = {
  filled: 'btn-industrial btn-fill',
  outline: 'btn-industrial btn-outline',
  ghost: 'btn-industrial btn-ghost',
};

const classes = `${variants[variant]} focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#c97b3a] ${className}`;
---

{href ? (
  <a href={href} class={classes} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}
